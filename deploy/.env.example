# Copy this file to `.env` and fill in real values BEFORE running `docker compose up`.
# DO NOT commit the resulting `.env` file (already in .gitignore).

# === Database ===
# Strong random password for internal n8n Postgres. Generate via: openssl rand -base64 32
POSTGRES_PASSWORD=

# === n8n ===
# Fixed encryption key — KEEP STABLE. Changing this invalidates all stored credentials.
# Generate ONCE via: openssl rand -base64 48
N8N_ENCRYPTION_KEY=

# Public host n8n diakses via HTTPS. Format: domain (bukan IP), tanpa scheme, tanpa port.
# Contoh: n8n.example.com — Caddy auto-provision Let's Encrypt cert untuk domain ini.
# DNS harus resolve dulu ke IP VPS sebelum start Caddy.
N8N_PUBLIC_HOST=

# === AI Provider ===
# OpenAI API key for direct OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# (Optional, kalau pakai OpenRouter sebagai alternatif)
OPENROUTER_API_KEY=

# === Bitrix24 — Project 1 (SPA Proposal Estimation, entityTypeId=2098) ===
# Currently points to DEMO instance (SPA hanya ada di demo).
# Format: https://<domain>/rest/<user_id>/<token>
BITRIX_WEBHOOK_BASE_URL=

# Entity Type ID dari SPA target. Default kita: 2098 (Proposal Estimation)
BITRIX_ENTITY_TYPE_ID=2098

# === Bitrix24 — Project 2 (TLDV Meeting Summary, CRM Lead) ===
# Points to PRODUCTION instance (real leads di sini).
# Generate dari Bitrix24: Developer resources → Other → Inbound webhook
BITRIX_PROD_URL=

# === TLDV (Project 2 only) ===
# TLDV API key untuk fetch meeting metadata + (opsional) transcript
# Generate dari TLDV: Settings → API → New key
TLDV_API_KEY=
