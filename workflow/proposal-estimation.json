            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-5.4-nano\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": {{ JSON.stringify($json.prompt) }} }\n  ],\n  \"temperature\": 0.2,\n  \"max_completion_tokens\": 2000\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "node-call-ai",
      "name": "Call OpenAI (gpt-5.4-nano)",
