      "position": [-280, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "rfp_text", "value": "", "type": "string" },
            { "id": "r2", "name": "item", "value": "={{ $('Bitrix: Get SPA Item').item.json.result.item }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "node-merge-no-rfp",
      "name": "Combine: no RFP",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-720, 440]
    },
    {
      "parameters": {
        "jsCode": "// Map Bitrix enum IDs to readable labels\nconst item = $input.item.json.item;\nconst rfp_text = $input.item.json.rfp_text;\n\n// === ENUM MAPPINGS (sumber: BITRIX_SCHEMA_REFERENCE.md) ===\nconst MAP_PLATFORM = { '9011': 'Web', '9013': 'Mobile', '9015': 'Portal', '9017': 'API' };\nconst MAP_INTEGRATE = { '9019': 'Yes', '9021': 'No' };\nconst MAP_COMPLEXITY = { '9023': 'Low', '9025': 'Medium', '9027': 'High' };\nconst MAP_TIMELINE = { '9029': 'Normal', '9031': 'Dipercepat' };\n\nconst lookup = (map, val) => map[String(val)] ?? `(unknown: ${val})`;\n\n// Platform is multi-select (array)\nconst platformIds = Array.isArray(item.ufCrm497Platform) ? item.ufCrm497Platform : (item.ufCrm497Platform ? [item.ufCrm497Platform] : []);\nconst platformLabels = platformIds.map(id => lookup(MAP_PLATFORM, id)).join(', ') || '(not specified)';\n\nreturn {\n  json: {\n    item_id: item.id,\n    title: item.title || '(no title)',\n    stage_id: item.stageId,\n    summary: item.ufCrm497Summary || '(empty)',\n    feature_list: item.ufCrm497FeatureList || '(empty)',\n    platform_labels: platformLabels,\n    is_integrate: lookup(MAP_INTEGRATE, item.ufCrm497IsIntegrate),\n    integration_detail: item.ufCrm497IntegrationDetail || '(empty)',\n    complexity: lookup(MAP_COMPLEXITY, item.ufCrm497Complexity),\n    user_scale: item.ufCrm497UserScale ?? 0,\n    timeline: lookup(MAP_TIMELINE, item.ufCrm497Timeline),\n    rfp_text: (rfp_text || '').slice(0, 20000) // cap to 20k chars to control AI token use\n  }\n};"
      },
      "id": "node-map-enums",
      "name": "Map Enums → Labels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-60, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "prompt",
              "value": "=Anda adalah konsultan teknis senior. Hitung estimasi breakdown mandays untuk project software berikut.\n\nPENTING: Output HARUS dalam SATU PARAGRAF tanpa newline (field Bitrix tidak render line break). Gunakan format compact ini PERSIS:\n\n1) <Modul A> (<X> MD) — <sub-komponen dipisah koma>; 2) <Modul B> (<X> MD) — <sub-komponen>; 3) ...; TOTAL: <Y> MD\n\nContoh output yang benar:\n1) Dashboard Project (10 MD) — UI/UX, Backend API, Charts; 2) Authentication (5 MD) — Login, JWT, Reset password; 3) Notifikasi Email (4 MD) — SMTP integrasi, Template, Trigger workflow; TOTAL: 19 MD\n\n== DATA PROJECT ==\nNama Project: {{ $json.title }}\nPlatform: {{ $json.platform_labels }}\nKompleksitas: {{ $json.complexity }}\nSkala User: {{ $json.user_scale }}\nTimeline Expectation: {{ $json.timeline }}\nButuh Integrasi: {{ $json.is_integrate }}\nDetail Integrasi: {{ $json.integration_detail }}\n\nRequirement Summary:\n{{ $json.summary }}\n\nFeature List:\n{{ $json.feature_list }}\n\nIsi dokumen RFP:\n{{ $json.rfp_text || '(tidak ada file RFP diupload)' }}\n\n== ATURAN OUTPUT ==\n- Jawab dalam Bahasa Indonesia\n- Output HARUS satu paragraf, TANPA newline / line break apapun\n- Pisahkan setiap modul dengan tanda \"; \" (semicolon + spasi)\n- Pisahkan nama modul & sub-komponen dengan \" — \" (em-dash + spasi)\n- Format setiap modul: \"N) Nama Modul (X MD) — komponen1, komponen2, ...\"\n- Tutup dengan \"; TOTAL: <Y> MD\"\n- JANGAN pakai markdown (no **, no #, no ```)\n- JANGAN pakai bullet • atau dash sebagai pemisah baris\n- JANGAN ada pengantar atau penutup, langsung breakdown\n- Realistis: estimasi sesuai kompleksitas + timeline + skala user",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-build-prompt",
      "name": "Build Prompt (EDIT ME)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [160, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
